# Decision model: TypeSafe Jev. One request decides the operation and every target head.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Required for TYPE_TEXT. Any OpenAI-compatible chat endpoint; credentials stay local.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Optional visual recovery. Set both key and an image-capable model to enable it.
VISION_MODEL_API_KEY=
VISION_MODEL_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=

# Optional roles; empty means reuse VISION_MODEL, with the same endpoint/key.
VISION_PLANNER_MODEL=
VISION_EXECUTOR_MODEL=
VISION_VERIFIER_MODEL=
# Thinking controls for DeepSeek-compatible models and OpenRouter; the value 'default' omits controls.
VISION_PLANNER_REASONING=low
VISION_EXECUTOR_REASONING=none
VISION_VERIFIER_REASONING=low
VISION_MODEL_TIMEOUT=90
# Full image is resized, never cropped. Coordinates use 0..1000 on each axis.
VISION_IMAGE_MAX_SIDE=1600
# Mean grayscale difference (0..255) for stall detection, not task completion.
VISION_CHANGE_THRESHOLD=3

# Device. Leave ADB_PATH empty when adb is on PATH.
ADB_PATH=C:\platform-tools\adb.exe
ANDROID_DEVICE=

# Extra seconds to wait after each executed action (0 = no extra pacing).
ACTION_INTERVAL=0
